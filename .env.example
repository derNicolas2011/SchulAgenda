# Supabase-Projekt: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Lokal meldet sich die App automatisch am Konto dev@agenda.test an
# (siehe supabase/seed.sql). Auf "false" setzen, um den echten
# Magic-Link-Weg zu testen. Wirkt nur im Dev-Server gegen localhost.
# VITE_DEV_AUTOLOGIN=false
